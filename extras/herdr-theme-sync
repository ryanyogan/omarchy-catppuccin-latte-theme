#!/usr/bin/env python3
"""Opt-in Omarchy hook: merge generated Herdr colors and reload the local server."""
from pathlib import Path
import os
import re
import shutil
import subprocess
import tempfile
import tomllib


def main():
    home = Path.home()
    generated = home / ".local/state/omarchy/current/theme/herdr.toml"
    config = home / ".config/herdr/config.toml"
    if not generated.is_file() or not config.is_file():
        return

    palette_text = generated.read_text()
    palette = tomllib.loads(palette_text)
    if set(palette) != {"theme"} or palette["theme"].get("auto_switch") is not False:
        raise ValueError("Expected an Omarchy-owned Herdr theme with auto_switch = false")

    original = config.read_text()
    before = tomllib.loads(original)
    # Preserve unrelated tables, comments, keybindings and terminal settings.
    # Refuse unusual TOML layouts if the semantic comparison below changes them.
    kept = []
    in_theme = False
    for line in original.splitlines(keepends=True):
        header = re.match(r"^\s*\[([^\[\]]+)\]\s*(?:#.*)?$", line)
        if header:
            name = header[1].strip()
            in_theme = name == "theme" or name.startswith("theme.")
        elif re.match(r"^\s*\[\[", line):
            in_theme = False
        if not in_theme:
            kept.append(line)
    updated = "".join(kept).rstrip() + "\n\n" + palette_text.rstrip() + "\n"
    after = tomllib.loads(updated)
    expected = dict(before, theme=palette["theme"])
    if after != expected:
        raise ValueError("Refusing to change non-theme Herdr configuration")

    if updated != original:
        backup = config.with_name("config.toml.before-omarchy-colors")
        if not backup.exists():
            shutil.copy2(config, backup)
        target = config.resolve()
        with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write(updated)
        try:
            temporary.chmod(target.stat().st_mode & 0o777)
            temporary.replace(target)
        finally:
            temporary.unlink(missing_ok=True)

    # A reload is still needed when the file matches but the live server is stale.
    # Use the default local server, even when invoked from a named/remote pane.
    env = {key: value for key, value in os.environ.items() if not key.startswith("HERDR_")}
    if shutil.which("herdr") and subprocess.run(
        ["herdr", "status", "server"], env=env, capture_output=True, timeout=5
    ).returncode == 0:
        subprocess.run(["herdr", "server", "reload-config"], env=env, check=True, timeout=5)


if __name__ == "__main__":
    main()
